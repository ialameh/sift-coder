{
  "name": "siftcoder",
  "version": "1.0.4",
  "description": "Persistent project memory + local-LLM offload + Salesforce domain skills for Claude Code",
  "author": {
    "name": "Sam Alameh",
    "email": "issam@alameh.com",
    "url": "https://github.com/ialameh"
  },
  "license": "MIT",
  "homepage": "https://github.com/ialameh/sift-coder",
  "repository": "https://github.com/ialameh/sift-coder",
  "keywords": ["memory", "salesforce", "agents", "ai", "claude-code", "ollama", "rag"],
  "skills": "./skills",
  "commands": "./commands",
  "mcpServers": {
    "siftcoder-memory": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/memory/mcp/server.js"],
      "env": {
        "SIFTCODER_NS": "v3"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/boundary-enforcer.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/capture-observation.mjs",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/detect-console-logs.mjs",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/inject-memories.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notification/pin-incident.mjs",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start/ensure-built.mjs",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start/spawn-daemon.mjs",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start/install-error-banner.mjs",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/stop/should-continue.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
