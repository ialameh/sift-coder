{
  "name": "siftcoder",
  "version": "1.0.8",
  "type": "module",
  "description": "Persistent project memory + local-LLM offload + Salesforce domain skills for Claude Code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "siftcoder": "bin/siftcoder.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
    "skills",
    "agents",
    "commands",
    "monitors",
    "scripts",
    ".claude-plugin",
    ".mcp.json",
    "settings.json",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "memory",
    "agentic",
    "salesforce",
    "ollama",
    "local-llm",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ialameh/siftcoder",
  "repository": {
    "type": "git",
    "url": "https://github.com/ialameh/siftcoder.git"
  },
  "bugs": {
    "url": "https://github.com/ialameh/siftcoder/issues"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^13.0.6",
    "gpt-tokenizer": "^2.5.2",
    "minimatch": "^10.2.5",
    "node-sqlite3-wasm": "^0.8.56",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
