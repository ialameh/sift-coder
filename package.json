{
  "name": "@siftcoder/core",
  "version": "2.0.0",
  "type": "module",
  "description": "Cross-platform autonomous multi-agent coding workflows for Claude Code - Git installation only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "siftcoder": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist",
    "postinstall": "npm run build"
  },
  "installation": {
    "method": "git",
    "repository": "https://github.com/ialameh/sift-coder.git",
    "note": "Install via git clone - npm marketplace installation is not supported"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "claude",
    "automation",
    "multi-agent",
    "workflow",
    "cross-platform",
    "siftcoder"
  ],
  "author": {
    "name": "Sam Alameh",
    "email": "local@local.dev",
    "url": "https://github.com/ialameh"
  },
  "license": "MIT",
  "homepage": "https://www.siftcoder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ialameh/sift-coder.git"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.5.2",
    "glob": "^11.0.0",
    "minimatch": "^10.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "boxen": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
