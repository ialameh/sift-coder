{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siftcoder.dev/schemas/observation.schema.json",
  "title": "SiftCoder Observation Schema",
  "description": "Schema for SiftCoder observation entries with agent attribution, workflow context, and learning extraction",
  "type": "object",
  "required": [
    "timestamp",
    "session_id",
    "agent",
    "workflow",
    "observation",
    "safety"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of observation",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier",
      "pattern": "^sess_[0-9]+$"
    },
    "agent": {
      "type": "string",
      "description": "Agent that performed this observation",
      "enum": [
        "siftcoder-planner",
        "siftcoder-coder",
        "siftcoder-investigator",
        "siftcoder-qa-reviewer",
        "siftcoder-qa-fixer",
        "siftcoder-documenter",
        "siftcoder-orchestrator"
      ]
    },
    "workflow": {
      "type": "object",
      "description": "Workflow context at time of observation",
      "required": ["feature", "subtask", "phase", "iteration"],
      "properties": {
        "feature": {
          "type": "string",
          "description": "Current feature being implemented"
        },
        "subtask": {
          "type": "string",
          "description": "Current subtask within feature"
        },
        "phase": {
          "type": "string",
          "description": "Workflow phase",
          "enum": ["PLANNING", "CODING", "QA", "DONE"]
        },
        "iteration": {
          "type": "integer",
          "description": "Iteration number within phase",
          "minimum": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "description": "Tool observation details",
      "required": ["type", "tool"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Observation type (usually matches tool name)",
          "enum": [
            "Read",
            "Write",
            "Edit",
            "Bash",
            "Grep",
            "Glob",
            "Task"
          ]
        },
        "tool": {
          "type": "string",
          "description": "Tool name used"
        },
        "files": {
          "type": "array",
          "description": "Files involved in observation",
          "items": { "type": "string" }
        },
        "narrative": {
          "type": "string",
          "description": "Natural language summary of what was done"
        },
        "outcomes": {
          "type": "object",
          "description": "Observation outcomes",
          "properties": {
            "lines_changed": {
              "type": "integer",
              "description": "Number of lines added/modified"
            },
            "files_modified": {
              "type": "integer",
              "description": "Number of files modified"
            },
            "quality_gates": {
              "type": "object",
              "description": "Quality gate results for this observation",
              "properties": {
                "format": { "type": "string" },
                "lint": { "type": "string" },
                "type_check": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "learning": {
      "type": "object",
      "description": "Knowledge extracted from this observation",
      "required": ["concepts", "facts", "gotchas"],
      "properties": {
        "concepts": {
          "type": "array",
          "description": "Technical concepts and terms",
          "items": { "type": "string" }
        },
        "facts": {
          "type": "array",
          "description": "Factual statements learned",
          "items": { "type": "string" }
        },
        "gotchas": {
          "type": "array",
          "description": "Tricky patterns and gotchas",
          "items": { "type": "string" }
        },
        "discovery_tokens": {
          "type": "integer",
          "description": "Estimated tokens saved by this learning",
          "minimum": 0
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "Safety and boundary verification",
      "required": ["boundary_check", "files_in_scope"],
      "properties": {
        "boundary_check": {
          "type": "string",
          "description": "Boundary check result",
          "enum": ["passed", "warning", "failed", "skipped"]
        },
        "files_in_scope": {
          "type": "boolean",
          "description": "Whether all files were in modifiable scope"
        },
        "blast_radius": {
          "type": "string",
          "description": "Blast radius analysis result"
        },
        "protected_files_touched": {
          "type": "array",
          "description": "List of protected files that were accessed",
          "items": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional observation metadata",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "description": "Tool execution duration in milliseconds"
        },
        "exit_code": {
          "type": "integer",
          "description": "Tool exit code"
        },
        "tags": {
          "type": "array",
          "description": "Observation tags",
          "items": { "type": "string" }
        }
      }
    }
  }
}
