{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siftcoder.dev/schemas/checkpoint.schema.json",
  "title": "SiftCoder Checkpoint Schema",
  "description": "Schema for SiftCoder checkpoint state with multi-agent tracking, quality gates, and token economics",
  "type": "object",
  "required": [
    "version",
    "name",
    "created_at",
    "workflow_phase",
    "agent",
    "project_root",
    "features",
    "quality_results",
    "boundaries",
    "token_economics"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "description": "Checkpoint identifier name",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when checkpoint was created",
      "format": "date-time"
    },
    "workflow_phase": {
      "type": "string",
      "description": "Current workflow phase",
      "enum": ["PLANNING", "CODING", "QA", "DONE"]
    },
    "iteration": {
      "type": "integer",
      "description": "Current iteration within this phase",
      "minimum": 1
    },
    "agent": {
      "type": "string",
      "description": "Current active agent",
      "enum": [
        "siftcoder-planner",
        "siftcoder-coder",
        "siftcoder-investigator",
        "siftcoder-qa-reviewer",
        "siftcoder-qa-fixer",
        "siftcoder-documenter",
        "siftcoder-analyst"
      ]
    },
    "project_root": {
      "type": "string",
      "description": "Absolute path to project root directory"
    },
    "features": {
      "type": "object",
      "description": "Feature queue status",
      "required": ["completed", "in_progress", "pending"],
      "properties": {
        "completed": {
          "type": "array",
          "description": "List of completed feature/subtask names",
          "items": { "type": "string" }
        },
        "in_progress": {
          "type": "array",
          "description": "List of in-progress feature/subtask names",
          "items": { "type": "string" }
        },
        "pending": {
          "type": "array",
          "description": "List of pending feature/subtask names",
          "items": { "type": "string" }
        }
      }
    },
    "quality_results": {
      "type": "object",
      "description": "Quality gate results at checkpoint time",
      "required": ["format", "lint", "type_check"],
      "properties": {
        "format": {
          "type": "object",
          "description": "Code formatter results",
          "required": ["status", "files_checked"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["passed", "warning", "failed", "skipped"]
            },
            "files_checked": {
              "type": "integer",
              "description": "Number of files formatted"
            },
            "time_ms": {
              "type": "integer",
              "description": "Formatter execution time in milliseconds"
            }
          }
        },
        "lint": {
          "type": "object",
          "description": "Linter results",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["passed", "warning", "failed", "skipped"]
            },
            "errors": {
              "type": "integer",
              "description": "Number of lint errors"
            },
            "warnings": {
              "type": "integer",
              "description": "Number of lint warnings"
            },
            "time_ms": {
              "type": "integer",
              "description": "Linter execution time in milliseconds"
            }
          }
        },
        "type_check": {
          "type": "object",
          "description": "Type checker results",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["passed", "warning", "failed", "skipped"]
            },
            "files_checked": {
              "type": "integer",
              "description": "Number of files type-checked"
            },
            "time_ms": {
              "type": "integer",
              "description": "Type checker execution time in milliseconds"
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "description": "File boundary state at checkpoint time",
      "required": ["modifiable", "protected", "blast_radius_verified"],
      "properties": {
        "modifiable": {
          "type": "array",
          "description": "List of modifiable file patterns",
          "items": { "type": "string" }
        },
        "protected": {
          "type": "array",
          "description": "List of protected file patterns",
          "items": { "type": "string" }
        },
        "blast_radius_verified": {
          "type": "boolean",
          "description": "Whether blast radius analysis was verified"
        },
        "last_check": {
          "type": "string",
          "description": "ISO 8601 timestamp of last boundary check",
          "format": "date-time"
        }
      }
    },
    "token_economics": {
      "type": "object",
      "description": "Token usage and efficiency metrics",
      "required": ["session_tokens", "discovery_tokens", "efficiency"],
      "properties": {
        "session_tokens": {
          "type": "integer",
          "description": "Total tokens used in session"
        },
        "discovery_tokens": {
          "type": "integer",
          "description": "Tokens saved via learned patterns",
          "minimum": 0
        },
        "efficiency": {
          "type": "string",
          "description": "Efficiency percentage (discovery_tokens / session_tokens)",
          "pattern": "^\\d+\\.\\d+%$"
        },
        "patterns_learned": {
          "type": "integer",
          "description": "Number of patterns/concepts learned"
        }
      }
    },
    "file_iteration": {
      "type": "object",
      "description": "File iteration state for analysis workflows",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Glob pattern for files being iterated"
        },
        "total_files": {
          "type": "integer",
          "description": "Total number of files to process",
          "minimum": 0
        },
        "processed_files": {
          "type": "integer",
          "description": "Number of files processed so far",
          "minimum": 0
        },
        "current_file": {
          "type": "string",
          "description": "Path to file currently being processed"
        },
        "insights_accumulated": {
          "type": "integer",
          "description": "Number of insights extracted so far",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "description": "ISO 8601 timestamp when iteration started",
          "format": "date-time"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional checkpoint metadata",
      "properties": {
        "observations": {
          "type": "integer",
          "description": "Number of tool observations captured"
        },
        "knowledge_entries": {
          "type": "integer",
          "description": "Number of knowledge entries created"
        },
        "description": {
          "type": "string",
          "description": "Human-readable checkpoint description"
        },
        "tags": {
          "type": "array",
          "description": "Checkpoint tags for organization",
          "items": { "type": "string" }
        }
      }
    }
  }
}
